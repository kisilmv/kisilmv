{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null && auth.token.email == 'ваша.адреса@gmail.com' && auth.token.email_verified == true",
        ".write": "auth != null && auth.token.email == 'ваша.адреса@gmail.com' && auth.token.email_verified == true",

        "state": {
          ".read": true
        },

        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "newData.isBoolean()"
          }
        },

        "responses": {
          "$slide": {
            "$uid": {
              ".write": "auth != null && auth.uid == $uid && root.child('rooms').child($room).child('state/slideId').val() == $slide && root.child('rooms').child($room).child('state/locked').val() != true && root.child('rooms').child($room).child('state/revealed').val() != true",
              ".validate": "newData.hasChildren(['v', 't']) && newData.child('v').isString() && newData.child('v').val().length > 0 && newData.child('v').val().length <= 300 && newData.child('t').val() == now",
              "v": { ".validate": true },
              "t": { ".validate": true },
              "$other": { ".validate": false }
            }
          }
        }
      }
    }
  }
}
